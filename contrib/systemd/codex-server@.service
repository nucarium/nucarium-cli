# An example, not something nucleated installs or starts.
#
# One Codex login's server, as a systemd user unit, so that nucleated has
# something to report as alive: `systemctl --user is-active
# codex-server@client-a.service` is what the heartbeat asks. The instance
# name is the environment's name.
#
#   systemctl --user enable --now codex-server@client-a.service
#
# and in nucleated's config:
#
#   [[environment]]
#   name = "client-a"
#   root = "/home/agent/client-a"
#   agent = "codex"
#   config_dir = "/home/agent/.codex-client-a"
#   unit = "codex-server@client-a.service"
#
# `codex app-server --listen unix:// --remote-control` runs Codex's server in
# the foreground, with its control socket in CODEX_HOME, so that
# `codex remote-control pair`, run as the same login, can print a code for
# the ChatGPT phone app. Tested with Codex 0.172.0, which labels the app
# server and remote control experimental.
#
# Signed out, the server stays up and no phone can reach it, so the unit
# starts it only for a ChatGPT login and otherwise stops, with no restart.
# An API-key login passes `codex login status` and cannot use remote
# control. After signing in:
#
#   CODEX_HOME=~/.codex-client-a codex login --device-auth
#   systemctl --user restart codex-server@client-a.service
#
# Active means the server is up and was signed in when it started. It does
# not mean a phone is paired: nucleated does not ask Codex anything.

[Unit]
Description=Codex server for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# That login's Codex config folder. It must exist. Codex's hooks inherit it,
# and it is how nucleated tells one login's hooks from another's: keep it the
# same as the environment's `config_dir`.
Environment=CODEX_HOME=%h/.codex-%i
# The folder a session starts in when its client names none: the
# environment's nucleus. Trust it in /etc/codex/config.toml.
WorkingDirectory=%h/%i
# Put the folder `codex` is installed in on this unit's PATH, or write its
# full path here. 78 is "not signed in with ChatGPT": no restart for it.
ExecStart=/bin/sh -c 'codex login status 2>&1 | grep -qx "Logged in using ChatGPT" || { echo "%i: not signed in with ChatGPT" >&2; exit 78; }; exec codex app-server --listen unix:// --remote-control'
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
NoNewPrivileges=yes

[Install]
WantedBy=default.target
